---
import { t, localizePath } from "../utils/i18n";
import i18next from "i18next";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  isHomePage?: boolean;
}

const { title, description = t("common.description"), isHomePage = false } = Astro.props;
const currentLanguage = i18next.language;
---

<!DOCTYPE html>
<html lang={currentLanguage}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-0DBME2ZW2S"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-0DBME2ZW2S');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={import.meta.env.BASE_URL + 'favicon.svg'} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700;900&display=swap"
      as="style"
      onload="this.rel='stylesheet'"
    />
    <slot name="head" />
  </head>
  <body class="font-sans bg-slate-50 text-slate-700 leading-relaxed">
    {!isHomePage ? (
      <>
        <header class="bg-white text-slate-900 py-4 shadow-md sticky top-0 z-50">
          <div class="max-w-container mx-auto px-4">
            <div class="flex items-center justify-between h-20">
              <h1 class="text-3xl font-bold text-slate-800 m-0">RunFun Blog</h1>
              <button class="menu-toggle bg-transparent border-none cursor-pointer text-slate-900 p-2 z-[101] relative" aria-label="Menu" aria-expanded="false">
                <svg class="menu-icon-open w-6 h-6 transition-opacity" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect y="4" width="24" height="2" fill="currentColor"></rect>
                  <rect y="11" width="24" height="2" fill="currentColor"></rect>
                  <rect y="18" width="24" height="2" fill="currentColor"></rect>
                </svg>
                <svg class="menu-icon-close w-6 h-6 transition-opacity absolute top-2 left-2 opacity-0" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </header>

        <!-- Mobile Menu Overlay -->
        <div class="mobile-menu-overlay fixed inset-0 bg-black/50 backdrop-blur-sm z-[99] opacity-0 invisible transition-all duration-300" id="menuOverlay"></div>

        <!-- Mobile Menu -->
        <nav class="mobile-menu fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-white shadow-2xl z-[100] transform translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto" id="mobileMenu">
          <div class="p-6 pt-20">
            <ul class="flex flex-col gap-4 list-none p-0 m-0">
              <li>
                <a href={localizePath("/")} class="block py-3 px-4 text-lg font-medium text-slate-700 no-underline rounded-lg hover:bg-slate-100 hover:text-blue-600 transition-colors">
                  {t("navigation.home")}
                </a>
              </li>
              <li>
                <a href={localizePath("/categories")} class="block py-3 px-4 text-lg font-medium text-slate-700 no-underline rounded-lg hover:bg-slate-100 hover:text-blue-600 transition-colors">
                  {t("navigation.categories")}
                </a>
              </li>
            </ul>
          </div>
        </nav>
      </>
    ) : (
      <>
        <header class="home-header fixed top-0 left-0 right-0 bg-transparent text-slate-900 py-4 z-[100]">
          <div class="max-w-container mx-auto px-4">
            <div class="flex justify-between items-center">
              <div class="logo">
                <a href={localizePath("/")} class="font-bold no-underline text-inherit text-2xl">RunFun</a>
              </div>
              <button class="menu-toggle bg-transparent border-none cursor-pointer text-slate-900 p-2 z-[101] relative" aria-label="Menu" aria-expanded="false">
                <svg class="menu-icon-open w-6 h-6" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect y="4" width="24" height="2" fill="currentColor"></rect>
                  <rect y="11" width="24" height="2" fill="currentColor"></rect>
                  <rect y="18" width="24" height="2" fill="currentColor"></rect>
                </svg>
                <svg class="menu-icon-close w-6 h-6 absolute top-2 left-2 opacity-0" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        </header>

        <!-- Mobile Menu Overlay -->
        <div class="mobile-menu-overlay fixed inset-0 bg-black/50 backdrop-blur-sm z-[99] opacity-0 invisible" id="menuOverlay"></div>

        <!-- Mobile Menu -->
        <nav class="mobile-menu fixed top-0 right-0 h-full w-80 max-w-[85vw] bg-white shadow-2xl z-[100] invisible overflow-y-auto" id="mobileMenu">
          <div class="p-6 pt-20">
            <ul class="flex flex-col gap-4 list-none p-0 m-0">
              <li>
                <a href="#home" class="block py-3 px-4 text-lg font-medium text-slate-700 no-underline rounded-lg hover:bg-slate-100 hover:text-blue-600 transition-colors">
                  {t("navigation.home")}
                </a>
              </li>
              <li>
                <a href="#service" class="block py-3 px-4 text-lg font-medium text-slate-700 no-underline rounded-lg hover:bg-slate-100 hover:text-blue-600 transition-colors">
                  SERVICE
                </a>
              </li>
              <li>
                <a href="#about" class="block py-3 px-4 text-lg font-medium text-slate-700 no-underline rounded-lg hover:bg-slate-100 hover:text-blue-600 transition-colors">
                  ABOUT
                </a>
              </li>
              <li>
                <a href={localizePath("/blog")} class="block py-3 px-4 text-lg font-medium text-slate-700 no-underline rounded-lg hover:bg-slate-100 hover:text-blue-600 transition-colors">
                  {t("navigation.blog")}
                </a>
              </li>
            </ul>
          </div>
        </nav>
      </>
    )}

    <main class={isHomePage ? "" : "max-w-container mx-auto px-4"}>
      <slot />
    </main>

    {!isHomePage && (
      <footer class="bg-gray-100 text-gray-500 py-12 mt-8 text-center">
        <div class="max-w-container mx-auto px-4">
          <p class="text-lg mb-2">&copy; {new Date().getFullYear()} RunFun. {t("common.copyright")}</p>
          <p class="text-sm">Designed with passion by RunFun.</p>
        </div>
      </footer>
    )}

    {isHomePage ? (
      <script>
      // Homepage interactions powered by GSAP (menu, anchor scrolling, header,
      // and per-section reveal animations). Non-homepage pages keep the vanilla
      // script below; nothing here runs on them.
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";
      import { ScrollToPlugin } from "gsap/ScrollToPlugin";

      gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // With reduced motion, every animation collapses to an instant state change.
      const dur = (d) => (prefersReducedMotion ? 0 : d);

      const container = document.querySelector('.fullscreen-container');
      const header = document.querySelector('.home-header');
      const menuToggle = document.querySelector('.menu-toggle');
      const mobileMenu = document.getElementById('mobileMenu');
      const menuOverlay = document.getElementById('menuOverlay');
      const menuIconOpen = document.querySelector('.menu-icon-open');
      const menuIconClose = document.querySelector('.menu-icon-close');
      let isMenuOpen = false;

      // --- Mobile menu: GSAP takes over transform/opacity/visibility ---
      // The panel's position is controlled by GSAP alone. Its markup carries
      // no Tailwind translate/transform utilities on purpose: Tailwind v4
      // implements translate-x-full with the CSS `translate` property, and
      // GSAP folds that offset into its transform cache as a phantom pixel
      // `x`, so animating xPercent back to 0 still left the panel exactly one
      // width off-screen. The `invisible` class only hides the panel until
      // this script runs; the set and the class removal happen in the same
      // synchronous block, before any paint can show the untransformed panel.
      if (mobileMenu && menuOverlay) {
        gsap.set(mobileMenu, { xPercent: 100, visibility: 'visible' });
        mobileMenu.classList.remove('invisible');
        gsap.set(menuOverlay, { autoAlpha: 0 });
        menuOverlay.classList.remove('opacity-0', 'invisible');
        if (menuIconClose) {
          gsap.set(menuIconClose, { autoAlpha: 0 });
          menuIconClose.classList.remove('opacity-0');
        }
        if (menuIconOpen) {
          gsap.set(menuIconOpen, { autoAlpha: 1 });
        }
      }

      const menuTimeline = gsap.timeline({ paused: true });
      if (mobileMenu && menuOverlay) {
        menuTimeline
          .to(menuOverlay, { autoAlpha: 1, duration: dur(0.3), ease: 'power2.out' }, 0)
          .to(mobileMenu, { xPercent: 0, duration: dur(0.45), ease: 'power3.out' }, 0)
          .to(menuIconOpen, { autoAlpha: 0, duration: dur(0.2), ease: 'power1.out' }, 0)
          .to(menuIconClose, { autoAlpha: 1, duration: dur(0.2), ease: 'power1.out' }, 0);
      }

      function openMenu() {
        if (!mobileMenu || !menuOverlay || !menuToggle) return;

        isMenuOpen = true;
        menuToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        menuTimeline.timeScale(1).play();
      }

      function closeMenu(onComplete) {
        if (!mobileMenu || !menuOverlay || !menuToggle || !isMenuOpen) {
          if (onComplete) onComplete();
          return;
        }

        isMenuOpen = false;
        menuToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        if (onComplete) {
          menuTimeline.eventCallback('onReverseComplete', () => {
            menuTimeline.eventCallback('onReverseComplete', null);
            onComplete();
          });
        }
        menuTimeline.timeScale(1.6).reverse();
      }

      menuToggle?.addEventListener('click', () => {
        if (isMenuOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      // Close menu when clicking overlay
      menuOverlay?.addEventListener('click', () => {
        closeMenu();
      });

      // --- Anchor links: close the menu, then scroll with ScrollToPlugin ---
      function scrollToSection(section) {
        if (!container || !section) return;

        gsap.to(container, {
          duration: dur(0.9),
          ease: 'power3.inOut',
          scrollTo: { y: section },
          onStart: () => {
            // scroll-snap would fight the tween frame by frame; disable it
            // while animating and restore it when the target snap point lands.
            container.style.scrollSnapType = 'none';
          },
          onComplete: () => {
            container.style.scrollSnapType = '';
          },
        });
      }

      const menuLinks = mobileMenu?.querySelectorAll('a');
      menuLinks?.forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          // Check if it's an anchor link (starts with #)
          if (href && href.startsWith('#')) {
            e.preventDefault();
            const targetElement = document.getElementById(href.substring(1));

            if (targetElement) {
              const section = targetElement.closest('section') || targetElement;
              // Chain the scroll after the menu-close animation (no setTimeout).
              closeMenu(() => scrollToSection(section));
            } else {
              closeMenu();
            }
          } else {
            // External link - just close menu
            closeMenu();
          }
        });
      });

      // Close menu on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isMenuOpen) {
          closeMenu();
        }
      });

      // --- Header: solid background once scrolled past 50px ---
      if (header && container) {
        const setHeaderSolid = (solid, immediate = false) => {
          gsap.to(header, {
            duration: immediate ? 0 : dur(0.35),
            ease: 'power2.out',
            backgroundColor: solid ? 'rgba(255, 255, 255, 0.95)' : 'rgba(255, 255, 255, 0)',
            boxShadow: solid
              ? '0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)'
              : '0 0 0 0 rgb(0 0 0 / 0)',
            backdropFilter: solid ? 'blur(4px)' : 'blur(0px)',
            overwrite: 'auto',
          });
        };

        if (container.scrollTop > 50) {
          setHeaderSolid(true, true);
        }

        ScrollTrigger.create({
          trigger: '#home',
          scroller: container,
          start: 'top top',
          end: '+=50',
          onLeave: () => setHeaderSolid(true),
          onEnterBack: () => setHeaderSolid(false),
        });
      }

      // --- Section reveal animations ---
      // Initial hidden states are set by GSAP itself (fromTo), never by CSS,
      // so content stays visible if JS is disabled or fails to load.
      if (!prefersReducedMotion && container) {
        // Hero logo: entrance animation on page load (fade + slight scale)
        const heroItems = document.querySelectorAll('#home [data-animate]');
        if (heroItems.length) {
          gsap.fromTo(heroItems,
            { autoAlpha: 0, scale: 0.92 },
            { autoAlpha: 1, scale: 1, duration: 0.9, ease: 'power3.out', delay: 0.15 });
        }

        gsap.utils.toArray('main section').forEach((section) => {
          if (section.id === 'home') return;

          const items = section.querySelectorAll('[data-animate]');
          if (!items.length) return;

          gsap.fromTo(items,
            { autoAlpha: 0, y: 32 },
            {
              autoAlpha: 1,
              y: 0,
              duration: 0.6,
              ease: 'power3.out',
              stagger: 0.08,
              scrollTrigger: {
                trigger: section,
                scroller: container,
                // Sections land via scroll-snap, so start a little earlier
                // than 70%: the reveal is well under way once a section has
                // snapped into place instead of trailing behind it.
                start: 'top 75%',
                toggleActions: 'play none none reverse',
              },
            });
        });

        window.addEventListener('load', () => ScrollTrigger.refresh());
      }
      </script>
    ) : (
      <script>
      // Mobile menu toggle functionality
      const menuToggle = document.querySelector('.menu-toggle');
      const mobileMenu = document.getElementById('mobileMenu');
      const menuOverlay = document.getElementById('menuOverlay');
      const menuIconOpen = document.querySelector('.menu-icon-open');
      const menuIconClose = document.querySelector('.menu-icon-close');
      let isMenuOpen = false;

      function openMenu() {
        if (!mobileMenu || !menuOverlay || !menuToggle) return;

        isMenuOpen = true;
        mobileMenu.classList.remove('translate-x-full');
        menuOverlay.classList.remove('opacity-0', 'invisible');
        menuOverlay.classList.add('opacity-100', 'visible');
        menuIconOpen?.classList.add('opacity-0');
        menuIconClose?.classList.remove('opacity-0');
        menuToggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        if (!mobileMenu || !menuOverlay || !menuToggle) return;

        isMenuOpen = false;
        mobileMenu.classList.add('translate-x-full');
        menuOverlay.classList.remove('opacity-100', 'visible');
        menuOverlay.classList.add('opacity-0', 'invisible');
        menuIconOpen?.classList.remove('opacity-0');
        menuIconClose?.classList.add('opacity-0');
        menuToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      menuToggle?.addEventListener('click', () => {
        if (isMenuOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });

      // Close menu when clicking overlay
      menuOverlay?.addEventListener('click', () => {
        closeMenu();
      });

      // Handle menu links - smooth scroll for anchor links, close menu
      const menuLinks = mobileMenu?.querySelectorAll('a');
      menuLinks?.forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          // Check if it's an anchor link (starts with #)
          if (href && href.startsWith('#')) {
            e.preventDefault();
            const targetId = href.substring(1);
            const targetElement = document.getElementById(targetId);

            if (targetElement) {
              // Close menu first
              closeMenu();

              // Small delay to allow menu to close, then scroll
              setTimeout(() => {
                const fullscreenContainer = document.querySelector('.fullscreen-container');
                if (fullscreenContainer) {
                  // Find the section element
                  const section = targetElement.closest('section');
                  if (section) {
                    // Scroll to the section - use scrollIntoView with smooth behavior
                    // This works with scroll-snap
                    section.scrollIntoView({
                      behavior: 'smooth',
                      block: 'start',
                      inline: 'nearest'
                    });
                  } else {
                    targetElement.scrollIntoView({
                      behavior: 'smooth',
                      block: 'start',
                      inline: 'nearest'
                    });
                  }
                } else {
                  // Fallback for normal scrolling
                  targetElement.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start',
                    inline: 'nearest'
                  });
                }
              }, 300); // Increased delay to ensure menu animation completes
            } else {
              closeMenu();
            }
          } else {
            // External link - just close menu
            closeMenu();
          }
        });
      });

      // Close menu on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isMenuOpen) {
          closeMenu();
        }
      });

      // Homepage scroll header effect and enhancements
      if (document.querySelector('.home-header')) {
        const header = document.querySelector('.home-header');
        const fullscreenContainer = document.querySelector('.fullscreen-container');

        if (fullscreenContainer && header) {
          // Optimized scroll handler using requestAnimationFrame
          let ticking = false;
          let lastScrollTop = 0;

          function updateHeader() {
            const scrollTop = fullscreenContainer.scrollTop;

            // Only update if scroll position changed significantly
            if (Math.abs(scrollTop - lastScrollTop) > 5) {
              if (scrollTop > 50) {
                header.classList.add('bg-white/95', 'backdrop-blur-sm', 'shadow-md');
              } else {
                header.classList.remove('bg-white/95', 'backdrop-blur-sm', 'shadow-md');
              }
              lastScrollTop = scrollTop;
            }

            ticking = false;
          }

          fullscreenContainer.addEventListener('scroll', () => {
            if (!ticking) {
              window.requestAnimationFrame(updateHeader);
              ticking = true;
            }
          }, { passive: true });
        }
      }
      </script>
    )}
  </body>
</html>
